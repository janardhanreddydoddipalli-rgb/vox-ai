{
  "name": "vox",
  "private": true,
  "description": "Vox — AI mock-interview voice assistant (monorepo)",
  "scripts": {
    "dev": "pnpm --filter @vox/web dev",
    "build": "pnpm --filter @vox/web build",
    "start": "pnpm --filter @vox/web start",
    "lint": "pnpm --filter @vox/web lint",
    "typecheck": "pnpm --filter @vox/web typecheck",
    "test": "pnpm --filter @vox/web test",
    "test:e2e": "pnpm --filter @vox/web test:e2e",
    "db:migrate": "pnpm --filter @vox/web db:migrate",
    "db:seed": "uv run --directory services/api python scripts/seed_questions.py",
    "eval": "uv run --directory services/api python -m evals.run"
  },
  "packageManager": "pnpm@11.6.0"
}
