# ---------------------------------------------------------------------------
# Vox web app (apps/web): UI, sign-in and API tokens only. The database, Gemini,
# rate limits and budgets are configured in services/api/.env.
# Local: .env.local (never committed). Production: Vercel Project Settings →
# Environment Variables. Secrets NEVER go in the repo.
# ---------------------------------------------------------------------------

# --- Auth (required) --------------------------------------------------------
# Auth.js v5 secret: generate with `openssl rand -base64 32`, store in Vault/Vercel.
AUTH_SECRET=
# Google OAuth: create an OAuth client in Google Cloud Console.
# Authorized redirect URI: {origin}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only when running a production build yourself (`next start`) outside Vercel.
# AUTH_TRUST_HOST=true
# Sign-in is Google-only (docs/adr/0002-google-only-auth.md).

# --- services/api (required) ------------------------------------------------
# EdDSA PRIVATE key that signs /api/token JWTs for the API. Generate the pair with
# `node scripts/generate-api-jwt-keys.mjs`; the PUBLIC half goes to services/api.
# Secret: web only, never the API, the browser, logs or git. Unset → /api/token answers 503.
API_JWT_PRIVATE_KEY=
# Server-to-server: where the web server reaches the API (pages, sign-in upsert),
# and the shared service credential (same value as services/api INTERNAL_API_TOKEN,
# at least 32 chars).
API_INTERNAL_URL=http://localhost:8000
INTERNAL_API_TOKEN=
# Where the browser reaches the API (public). services/api must allow this site's
# origin (its WEB_ORIGIN).
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Site ---------------------------------------------------------------------
# Public origin used by metadata, sitemap and robots (default: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=

# --- Tests ----------------------------------------------------------------------
# Test-only credentials provider for Playwright E2E (never set in production).
E2E_TEST_AUTH=

# --- Observability ----------------------------------------------------------------
# Sentry: client + server error monitoring. Without a DSN the SDK is inert.
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_RELEASE=
