{
  "name": "@vox/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Typed client for services/api, generated from its OpenAPI schema",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/schema.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^7.0.2"
  }
}
