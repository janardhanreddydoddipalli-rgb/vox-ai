  "info": {
    "title": "Vox API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/chat": {
      "post": {
        "operationId": "chat_stream_v1_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {}
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "Rate limited"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Stream a spoken reply (SSE: meta, token, sentence, done | error)",
        "tags": [
          "chat"
        ]
      }
    },
    "/v1/health": {
      "get": {
        "operationId": "health_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness: the process is up",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/health/ready": {
      "get": {
        "operationId": "ready_v1_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "description": "Database unreachable (problem+json)"
          }
        },
        "summary": "Readiness: the database answers",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/interviews": {
      "get": {
        "operationId": "list_interviews_v1_interviews_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InterviewList"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "My interviews, newest first (max 50)",
        "tags": [
          "interviews"
        ]
      },
      "post": {
        "operationId": "create_interview_v1_interviews_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_create_interview_v1_interviews_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InterviewCreated"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "Unreadable or oversized r\u00e9sum\u00e9"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "Rate limited"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Start an interview (optionally with a r\u00e9sum\u00e9 PDF and a job description)",
        "tags": [
          "interviews"
        ]
