{
  "components": {
    "schemas": {
      "AllTurns": {
        "properties": {
          "sessions": {
            "items": {
              "type": "string"
            },
            "title": "Sessions",
            "type": "array"
          },
          "turns": {
            "items": {
              "$ref": "#/components/schemas/Turn"
            },
            "title": "Turns",
            "type": "array"
          }
        },
        "required": [
          "sessions",
          "turns"
        ],
        "title": "AllTurns",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "Health",
        "type": "object"
      },
      "Me": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "image": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "image",
          "created_at"
        ],
        "title": "Me",
        "type": "object"
      },
      "Memory": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "text",
          "created_at"
        ],
        "title": "Memory",
        "type": "object"
      },
      "MemoryList": {
        "properties": {
          "memories": {
            "items": {
              "$ref": "#/components/schemas/Memory"
            },
            "title": "Memories",
            "type": "array"
          }
        },
        "required": [
          "memories"
        ],
        "title": "MemoryList",
        "type": "object"
      },
      "Readiness": {
        "properties": {
          "database": {
            "const": "ok",
            "default": "ok",
            "title": "Database",
            "type": "string"
          },
          "status": {
            "const": "ready",
            "default": "ready",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "Readiness",
        "type": "object"
      },
      "SessionTurns": {
        "properties": {
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "turns": {
            "items": {
              "$ref": "#/components/schemas/Turn"
            },
            "title": "Turns",
            "type": "array"
          }
        },
        "required": [
          "session_id",
          "turns"
        ],
        "title": "SessionTurns",
        "type": "object"
      },
      "Turn": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "first_token_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Token Ms"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "latency_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latency Ms"
          },
          "role": {
            "title": "Role",
            "type": "string"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "stt_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stt Ms"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "total_llm_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Llm Ms"
          },
          "tts_start_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tts Start Ms"
          }
        },
        "required": [
          "id",
          "session_id",
          "role",
          "text",
          "latency_ms",
          "stt_ms",
          "first_token_ms",
          "total_llm_ms",
          "tts_start_ms",
          "created_at"
        ],
        "title": "Turn",
        "type": "object"
      },
      "TurnIn": {
        "properties": {
          "first_token_ms": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Token Ms"
          },
          "latency_ms": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latency Ms"
          },
          "role": {
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role",
            "type": "string"
          },
          "stt_ms": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stt Ms"
          },
          "text": {
            "maxLength": 5000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          },
          "total_llm_ms": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Llm Ms"
          },
          "tts_start_ms": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tts Start Ms"
          }
        },
        "required": [
          "role",
          "text"
        ],
        "title": "TurnIn",
        "type": "object"
      },
      "TurnsIn": {
        "properties": {
          "mode": {
            "default": "browser",
            "enum": [
              "gemini",
              "browser"
            ],
            "title": "Mode",
            "type": "string"
          },
          "turns": {
            "items": {
              "$ref": "#/components/schemas/TurnIn"
            },
            "maxItems": 200,
            "title": "Turns",
            "type": "array"
          }
        },
        "required": [
          "turns"
        ],
        "title": "TurnsIn",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "5-minute EdDSA JWT from apps/web /api/token",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Vox API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "health_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness: the process is up",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/health/ready": {
      "get": {
        "operationId": "ready_v1_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "description": "Database unreachable (problem+json)"
          }
        },
        "summary": "Readiness: the database answers",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/me": {
      "get": {
        "operationId": "me_v1_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Missing, invalid or expired token (problem+json)"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "The signed-in user",
        "tags": [
          "users"
        ]
      }
    },
    "/v1/memories": {
      "get": {
        "operationId": "list_memories_v1_memories_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemoryList"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "My memories, newest first",
        "tags": [
          "memories"
        ]
      }
    },
    "/v1/memories/{memory_id}": {
      "delete": {
        "operationId": "delete_memory_v1_memories__memory_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "memory_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Memory Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "description": "Not found, or not yours (problem+json)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "Rate limited"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Forget one memory",
        "tags": [
          "memories"
        ]
      }
    },
    "/v1/sessions/{session_id}/turns": {
      "get": {
        "operationId": "session_turns_v1_sessions__session_id__turns_get",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:-]+$",
              "title": "Session Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionTurns"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Not found, or not yours (problem+json)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "One of my sessions",
        "tags": [
          "turns"
        ]
      },
      "post": {
        "operationId": "save_turns_v1_sessions__session_id__turns_post",
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "schema": {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:-]+$",
              "title": "Session Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TurnsIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionTurns"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Not found, or not yours (problem+json)"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "Rate limited"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Append turns to my session (created on first save)",
        "tags": [
          "turns"
        ]
      }
    },
    "/v1/turns": {
      "get": {
        "operationId": "list_turns_v1_turns_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AllTurns"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "All my sessions and their turns",
        "tags": [
          "turns"
        ]
      }
    }
  }
}
