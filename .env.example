# Gemini (server-only — no NEXT_PUBLIC_ prefix, never commit real values)
GEMINI_API_KEY=your-gemini-api-key

# Model to call via generateContent (default: gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# How many past turns are sent as context (default: 8)
CHAT_CONTEXT_TURNS=8

# Postgres connection for production (Phase 2). Local dev uses SQLite in ./data.
DATABASE_URL=postgresql://user:password@localhost:5432/voicebot

# Required to read conversation history via GET /api/turns (interim until real auth).
ADMIN_TOKEN=generate-a-long-random-string
