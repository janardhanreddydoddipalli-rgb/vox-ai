# ---------------------------------------------------------------------------
# Vox environment variables
# Staging: set these in your staging host's env settings (or .env.local for
# local dev — never committed). Production: Vercel Project Settings →
# Environment Variables. Secrets NEVER go in the repo.
# ---------------------------------------------------------------------------

# --- Database (required) ----------------------------------------------------
# Staging/production: Neon pooled connection string (pgBouncer endpoint).
DATABASE_URL=postgresql://user:password@localhost:5432/voicebot
# Unpooled endpoint, used only by drizzle-kit migrations (Neon direct URL).
# DATABASE_URL_UNPOOLED=postgresql://user:password@host/voicebot
# Local Postgres for tests (never point tests at staging/prod).
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/voicebot_test

# --- Auth (required) --------------------------------------------------------
# Auth.js v5 secret: generate with `openssl rand -base64 32`, store in Vault/Vercel.
AUTH_SECRET=
# Google OAuth: create an OAuth client in Google Cloud Console.
# Authorized redirect URI: {origin}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email magic links via Resend (https://resend.com).
RESEND_API_KEY=
EMAIL_FROM="Vox <onboarding@resend.dev>"

# --- Rate limiting (required in production) ---------------------------------
# Upstash Redis REST credentials; the in-memory limiter is the dev fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Gemini (required) ------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
# Model to call via generateContent (default: gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash
# How many past turns are sent as context (default: 8)
CHAT_CONTEXT_TURNS=8
