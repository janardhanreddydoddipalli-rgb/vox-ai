# ---------------------------------------------------------------------------
# Vox API (services/api) environment. Copy to services/api/.env for local
# runs (git-ignored). In production, set these in the container host's
# secret manager. Secrets NEVER go in the repo.
# ---------------------------------------------------------------------------

# development | test | staging | production  (production hides /docs)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Postgres. App: Neon POOLED URL. Migrations (alembic): Neon DIRECT URL.
# libpq params (sslmode, channel_binding) are translated for asyncpg.
DATABASE_URL=postgresql://ubuntu:ubuntu@localhost:5432/voicebot

# The one browser origin allowed by CORS (the web app).
WEB_ORIGIN=http://localhost:3000

# EdDSA PUBLIC key (PEM) that verifies tokens minted by apps/web /api/token.
# Generate the pair with: node apps/web/scripts/generate-api-jwt-keys.mjs
# One line with literal \n is fine.
JWT_PUBLIC_KEY=
# JWT_ISSUER=vox-web
# JWT_AUDIENCE=vox-api
# JWT_LEEWAY_SECONDS=30

# Service credential apps/web sends as X-Internal-Token to /internal/*.
# At least 32 characters: `openssl rand -hex 32`. Same value as INTERNAL_API_TOKEN in apps/web.
INTERNAL_API_TOKEN=

# Gemini. Unset: model features degrade like apps/web's (heuristic résumé parse,
# no embeddings; reports with answers return 502).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview

# Per-user daily token budget across every paid model call (0 = off).
DAILY_TOKEN_BUDGET=200000

# Shared rate limiting: the same Upstash database as apps/web. Unset → in-memory
# (per process; warns in production).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional error monitoring (user id only, no bodies).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
